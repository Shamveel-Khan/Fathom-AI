# Neon PostgreSQL Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
# Example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://your_user:your_password@your_neon_host.neon.tech/neondb?sslmode=require"

# OpenAI API Key (Optional server fallback — users can also provide BYOK key directly in UI)
OPENAI_API_KEY=""

# Optional Custom Base URL (e.g. OpenRouter, Groq, Ollama)
OPENAI_BASE_URL=""
